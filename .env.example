# Copy to .env. Relative paths resolve from the repository root.
# Non-secret configuration only; set temporary AWS credentials in your terminal.
RD_BACKEND=duckdb
RD_DATA_DIR=data/synthetic
RD_RUNTIME_DIR=runtime

# Required only for live Bedrock agents.
AWS_REGION=us-east-1
RD_MODEL_ID=
RD_FAST_MODEL_ID=
RD_GUARDRAIL_ID=
RD_GUARDRAIL_VERSION=DRAFT

# For Athena: set RD_BACKEND=athena and choose your authorized private resources.
RD_ATHENA_DB=aldo_returns
RD_ATHENA_OUTPUT=
RD_ATHENA_WORKGROUP=primary

# Optional override for the historical impact panel; ignored for synthetic demos.
# RD_BACKTEST_PATH=runtime/evaluation/cases_backtest.csv
