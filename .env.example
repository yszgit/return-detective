# Copy to .env. Relative paths resolve from the repository root.
# Non-secret configuration only; set temporary AWS credentials in your terminal.
RD_BACKEND=duckdb
RD_DATA_DIR=data/synthetic
RD_RUNTIME_DIR=runtime

# Required only for live Bedrock agents.
AWS_REGION=us-east-1
RD_MODEL_ID=
RD_FAST_MODEL_ID=
RD_GUARDRAIL_ID=
RD_GUARDRAIL_VERSION=DRAFT

# For Athena: set RD_BACKEND=athena and choose your authorized private resources.
RD_ATHENA_DB=aldo_returns
RD_ATHENA_OUTPUT=
RD_ATHENA_WORKGROUP=primary
# Set to 2 when Athena exposes all tables from data/cleaned/manifest.json.
# Local DuckDB detects this version from the selected manifest.
RD_DATASET_VERSION=

# After deploying aws/return-detective.yaml, copy its outputs here.
# Keep the local defaults until the storage connection check succeeds.
# RD_BACKEND=athena
# RD_DATASET_KIND=synthetic
# RD_S3_BUCKET=
# RD_ATHENA_DB=aldo_returns
# RD_ATHENA_OUTPUT=s3://<bucket>/athena-results/
# RD_ATHENA_WORKGROUP=<stack-name>-queries
# RD_STORE_BACKEND=dynamodb
# RD_STORE_NAMESPACE=<unique-team-member-or-demo-name>
# RD_CASES_TABLE=<stack-name>-cases
# RD_ACTIONS_TABLE=<stack-name>-actions
# RD_APPROVALS_TABLE=<stack-name>-approvals

# Optional override for the historical impact panel; ignored for synthetic demos.
# RD_BACKTEST_PATH=runtime/evaluation/cases_backtest.csv
